(ns forestry-technician.governor-test
  (:require [clojure.test :refer [deftest is testing]]
            [forestry-technician.store :as store]
            [forestry-technician.governor :as governor]))

(defn- fresh-store []
  (let [st (store/mem-store)]
    (store/register-technician! st {:technician-id "tech-1" :name "Alice Forest" :verified? true})
    (store/register-forest! st {:forest-id "forest-1" :technician-id "tech-1" :location "North Stand" :registered? true})
    st))

(deftest ok-on-clean-site-assessment
  (let [st (fresh-store)
        proposal {:op :log-site-assessment :effect :propose :confidence 0.9 :stake :low}
        v (governor/check {:technician-id "tech-1" :forest-id "forest-1"} {} proposal st)]
    (is (:ok? v))
    (is (not (:hard? v)))
    (is (not (:escalate? v)))))

(deftest hard-on-unregistered-technician
  (let [st (fresh-store)
        proposal {:op :log-site-assessment :effect :propose :confidence 0.9 :stake :low}
        v (governor/check {:technician-id "no-such-tech" :forest-id "forest-1"} {} proposal st)]
    (is (:hard? v))
    (is (some #(= :no-technician (:rule %)) (:violations v)))))

(deftest hard-on-unverified-technician
  (let [st (store/mem-store)
        _ (store/register-technician! st {:technician-id "tech-2" :name "Unverified Tech" :verified? false})
        _ (store/register-forest! st {:forest-id "forest-2" :technician-id "tech-2" :location "South Stand" :registered? true})
        proposal {:op :log-site-assessment :effect :propose :confidence 0.9 :stake :low}
        v (governor/check {:technician-id "tech-2" :forest-id "forest-2"} {} proposal st)]
    (is (:hard? v))
    (is (some #(= :no-technician (:rule %)) (:violations v)))))

(deftest hard-on-unregistered-forest
  (let [st (fresh-store)
        proposal {:op :log-site-assessment :effect :propose :confidence 0.9 :stake :low}
        v (governor/check {:technician-id "tech-1" :forest-id "no-such-forest"} {} proposal st)]
    (is (:hard? v))
    (is (some #(= :no-forest (:rule %)) (:violations v)))))

(deftest hard-on-no-actuation-violation
  (let [st (fresh-store)
        proposal {:op :log-site-assessment :effect :direct-write :confidence 0.9 :stake :low}
        v (governor/check {:technician-id "tech-1" :forest-id "forest-1"} {} proposal st)]
    (is (:hard? v))
    (is (some #(= :no-actuation (:rule %)) (:violations v)))))

(deftest escalates-on-pest-disease-flag
  (let [st (fresh-store)
        proposal {:op :flag-pest-disease-risk :effect :propose :confidence 0.9 :stake :high}
        v (governor/check {:technician-id "tech-1" :forest-id "forest-1"} {} proposal st)]
    (is (:escalate? v))
    (is (not (:hard? v)))))

(deftest escalates-on-schedule-site-visit
  (let [st (fresh-store)
        proposal {:op :schedule-site-visit :effect :propose :confidence 0.9 :stake :medium}
        v (governor/check {:technician-id "tech-1" :forest-id "forest-1"} {} proposal st)]
    (is (:escalate? v))
    (is (not (:hard? v)))))

(deftest ok-on-run-test-protocol
  (let [st (fresh-store)
        proposal {:op :run-test-protocol :effect :propose :confidence 0.9 :stake :low}
        v (governor/check {:technician-id "tech-1" :forest-id "forest-1"} {} proposal st)]
    (is (:ok? v))
    (is (not (:hard? v)))
    (is (not (:escalate? v)))))

(deftest escalates-on-low-confidence
  (let [st (fresh-store)
        proposal {:op :log-site-assessment :effect :propose :confidence 0.2 :stake :low}
        v (governor/check {:technician-id "tech-1" :forest-id "forest-1"} {} proposal st)]
    (is (:escalate? v))
    (is (not (:hard? v)))))

(deftest store-records-and-ledger-append-only
  (let [st (fresh-store)]
    (store/commit-record! st {:forest-id "forest-1" :op :log-site-assessment})
    (store/append-ledger! st {:disposition :commit})
    (is (= 1 (count (store/records-of st "forest-1"))))
    (is (= 1 (count (store/ledger st))))))

(deftest hard-violation-holds-rather-than-escalating
  ;; An escalating op from an unregistered technician must not reach the
  ;; human approval queue: the docstring's HARD invariants ALWAYS :hold, so
  ;; the verdict names the violation and does not also ask for sign-off.
  (let [st (fresh-store)
        proposal {:op :flag-pest-disease-risk :effect :propose :confidence 0.9 :stake :high}
        v (governor/check {:technician-id "no-such-tech" :forest-id "forest-1"} {} proposal st)]
    (is (:hard? v))
    (is (not (:escalate? v)))
    (is (not (:ok? v)))))
